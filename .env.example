# Copy to .env and fill in. Never commit .env.

# --- Web app ---
# Long random string used to sign session cookies.
SESSION_SECRET=
PUBLIC_URL=http://localhost:8000
# Lets anyone sign in to a sample child without Schoology. Turn off in production.
DEMO_MODE=true

# Fernet key that encrypts Schoology tokens and parents' own AI keys at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Admin panel (/admin) ---
ADMIN_PASSWORD=

# --- Supabase (Project Settings -> Database -> Connection string, "Session pooler") ---
DATABASE_URL=
# A separate, empty Supabase project for the tests. Tests never touch DATABASE_URL.
TEST_DATABASE_URL=

# --- Schoology (App Center developer app, three-legged OAuth) ---
SCHOOLOGY_CONSUMER_KEY=
SCHOOLOGY_CONSUMER_SECRET=
# Districts in the sign-in dropdown, "Name=domain" separated by commas. Find a district's
# domain in the address bar after signing in to Schoology (not the district's SSO page).
SCHOOLOGY_DISTRICTS=Irving ISD=irvingisd.schoology.com,Grand Prairie ISD=gpisd.schoology.com
# Other addresses parents may type in under "Other address". "*." matches subdomains.
SCHOOLOGY_ALLOWED_DOMAINS=*.schoology.com

# --- AI providers (the app's own keys; provider and model are chosen in /admin) ---
HF_TOKEN=
ANTHROPIC_API_KEY=

# --- Optional email delivery for weekly summaries and alerts ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
